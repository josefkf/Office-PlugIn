{
  "name": "brand-assets-addin",
  "version": "1.0.0",
  "description": "Office add-in: insert brand images from a SharePoint library into Word, Excel and PowerPoint",
  "scripts": {
    "build": "node build.mjs",
    "dev-certs": "npx office-addin-dev-certs install",
    "start": "npx http-server dist -S -C %USERPROFILE%/.office-addin-dev-certs/localhost.crt -K %USERPROFILE%/.office-addin-dev-certs/localhost.key -p 3000 -c-1",
    "test": "node build.mjs --mock-auth && node test/e2e.mjs"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@azure/msal-browser": "5.23.0"
  },
  "devDependencies": {
    "esbuild": "0.27.0",
    "playwright": "1.56.0"
  },
  "private": true
}
